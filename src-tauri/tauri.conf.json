{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "In8",
  "mainBinaryName": "in8",
  "version": "0.1.0",
  "identifier": "dev.in8.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "In8",
        "width": 1100,
        "height": 720,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "deb",
      "appimage"
    ],
    "publisher": "In8",
    "category": "Utility",
    "shortDescription": "Get a freshly formatted PC ready",
    "longDescription": "Installs your apps, removes bloatware, applies tweaks and runs post-install setup on Windows and Linux, with profiles and backups.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "pkexec | policykit-1"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRGQjRGNkRDRDBCOTQ0RkEKUldUNlJMblEzUGEwVDdVbThESGVsK1Riei9UOEQvWkNuenhaaTdMeGZFdytrZ2pBRHZLaENDWlAK",
      "endpoints": [
        "https://github.com/OWNER/REPO/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
